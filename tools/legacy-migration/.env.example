# Legacy migration (DATABASE.md §11, docs/runbooks/cutover.md). Copy to .env (git-ignored) on the
# machine that runs the migration. Never commit real connection strings.
#
# The OLD system's database, read only. Best: a read-only role on the old Neon project.
LEGACY_DATABASE_URL=
# The NEW system's database, DIRECT (non-pooled) Neon endpoint, already migrated with
# `pnpm --filter @pos/database migrate:deploy`.
TARGET_DATABASE_URL=
# How the old system stored `timestamp without time zone` values: UTC (default) or Asia/Karachi.
LEGACY_NAIVE_TIMESTAMPS=UTC
