# Legacy migration (README.md). Copy to .env (git-ignored) in this folder on the machine that runs the
# migration. Never commit real connection strings, and never paste them into logs or chats.
#
# The OLD system's database. Only ever read: the tool opens it in a read-only session.
# Best: a read-only role on the old Neon project.
LEGACY_DATABASE_URL=
# The NEW system's database, already migrated with `pnpm --filter @pos/database migrate:deploy`.
# Use the DIRECT endpoint (host without "-pooler"): the write is one long transaction.
TARGET_DATABASE_URL=
# Optional: rows per read page and per INSERT (1–5,000, default 500).
MIGRATION_BATCH_SIZE=500
# Optional: where run folders go (default: output/ in this folder, git-ignored).
MIGRATION_OUTPUT_DIR=
# How the old system stored `timestamp without time zone` values: UTC (default) or Asia/Karachi.
# The old database has none today (every timestamp has a time zone), so this has no effect.
LEGACY_NAIVE_TIMESTAMPS=UTC
