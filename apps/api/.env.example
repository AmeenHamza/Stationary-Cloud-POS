# Local development only (DEPLOYMENT.md §4.1). Copy to .env (git-ignored).
NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://pos:change-me-local-only@localhost:5432/pos_dev
REDIS_URL=redis://:change-me-local-only@localhost:6379/0
WEB_ORIGIN=http://localhost:3001
BUSINESS_TIMEZONE=Asia/Karachi
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
# Set a unique secret to enable self-service signup; leave empty to disable it.
SIGNUP_SECRET=
# base64 of 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=
METRICS_TOKEN=change-me-at-least-32-characters-long
LOG_LEVEL=info
# Integration tests (TESTING.md §2): admin URL (CREATEDB) and Redis logical DB 15.
TEST_DATABASE_URL=postgresql://pos:change-me-local-only@localhost:5432/postgres
TEST_REDIS_URL=redis://:change-me-local-only@localhost:6379/15

# --- Neon (cloud database) -------------------------------------------------------------------
# To run the API against Neon instead of the local database: paste the POOLED connection string
# (host contains "-pooler") below, uncomment it, and comment out the local DATABASE_URL above.
# Integration tests keep using TEST_DATABASE_URL (local), never Neon.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

# --- Upstash Redis (TLS) -------------------------------------------------------------------
# Replace the active REDIS_URL above with the Upstash Redis/TLS URL, not the REST URL or token.
# Keep TEST_REDIS_URL local; never use a development or production Redis for integration tests.
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
