// Catalogue: categories, products and the append-only stock ledger (DATABASE.md §4.4–4.6).
// Partial, trigram and pattern indexes plus CHECK constraints live in the migration SQL.

enum SaleUnit {
  PIECE
  BOX

  @@map("sale_unit")
}

enum StockMovementType {
  OPENING
  SALE
  REFUND
  RESTOCK
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  MIGRATION

  @@map("stock_movement_type")
}

enum AdjustmentReason {
  DAMAGED
  LOST
  COUNT_CORRECTION
  OTHER

  @@map("adjustment_reason")
}

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique(map: "categories_name_uq") @db.Citext
  iconEmoji   String?  @map("icon_emoji") @db.VarChar(16)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int      @default(1)
  legacyId    String?  @map("legacy_id") @db.VarChar(64)

  products Product[]

  @@index([name, id], map: "categories_name_id_idx")
  @@map("categories")
}

model Product {
  id                      String    @id @default(uuid(7)) @db.Uuid
  barcode                 String?   @db.VarChar(64)
  name                    String    @db.VarChar(200)
  nameKey                 String    @map("name_key") @db.VarChar(200)
  nameUrdu                String?   @map("name_urdu") @db.VarChar(200)
  categoryId              String?   @map("category_id") @db.Uuid
  baseUnitLabel           String    @default("Piece") @map("base_unit_label") @db.VarChar(20)
  piecesPerBox            Int       @default(1) @map("pieces_per_box")
  salePrice               Decimal   @map("sale_price") @db.Decimal(12, 2)
  boxPrice                Decimal?  @map("box_price") @db.Decimal(12, 2)
  costPrice               Decimal?  @map("cost_price") @db.Decimal(12, 2)
  taxRate                 Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lowStockThresholdPieces Int       @default(10) @map("low_stock_threshold_pieces")
  lowStockThresholdUnit   SaleUnit  @default(PIECE) @map("low_stock_threshold_unit")
  stockPieces             Int       @default(0) @map("stock_pieces")
  clonedFromId            String?   @map("cloned_from_id") @db.Uuid
  idempotencyKey          String?   @unique(map: "products_idempotency_key_uq") @map("idempotency_key") @db.Uuid
  requestHash             Bytes?    @map("request_hash")
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                 Int       @default(1)
  legacyId                String?   @map("legacy_id") @db.VarChar(64)
  legacyBarcode           String?   @map("legacy_barcode") @db.VarChar(128)

  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "products_category_fk")
  clonedFrom Product?        @relation("ProductClones", fields: [clonedFromId], references: [id], onDelete: Restrict, map: "products_cloned_from_fk")
  clones     Product[]       @relation("ProductClones")
  movements  StockMovement[]
  orderLines OrderLine[]
  importRows ImportJobRow[]

  @@index([categoryId], map: "products_category_fk_idx")
  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_key_trgm_idx")
  @@index([nameUrdu(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_urdu_trgm_idx")
  @@map("products")
}

model StockMovement {
  id             BigInt            @id @default(autoincrement())
  productId      String            @map("product_id") @db.Uuid
  type           StockMovementType
  quantityPieces Int               @map("quantity_pieces")
  balanceAfter   Int               @map("balance_after")
  reason         AdjustmentReason?
  note           String?           @db.VarChar(200)
  orderId        String?           @map("order_id") @db.Uuid
  refundId       String?           @map("refund_id") @db.Uuid
  importJobId    String?           @map("import_job_id") @db.Uuid
  idempotencyKey String?           @unique(map: "stock_movements_idempotency_key_uq") @map("idempotency_key") @db.Uuid
  requestHash    Bytes?            @map("request_hash")
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict, map: "stock_movements_product_fk")
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "stock_movements_order_fk")
  refund    Refund?    @relation(fields: [refundId], references: [id], onDelete: Restrict, map: "stock_movements_refund_fk")
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: Restrict, map: "stock_movements_import_job_fk")
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: Restrict, map: "stock_movements_actor_fk")

  @@index([productId, createdAt(sort: Desc), id(sort: Desc)], map: "stock_movements_product_created_idx")
  @@map("stock_movements")
}
