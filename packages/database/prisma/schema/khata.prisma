// Customer and vendor khata (DATABASE.md §4.7–4.8): balances plus append-only ledgers with running balance.
// CHECKs, partial indexes and the trigram index live in the migration SQL.

enum PaymentMethod {
  CASH
  CARD
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
  UDHAAR

  @@map("payment_method")
}

enum CustomerEntryType {
  OPENING_BALANCE
  CREDIT_SALE
  MANUAL_CREDIT
  PAYMENT
  REFUND_CREDIT

  @@map("customer_entry_type")
}

enum VendorEntryType {
  OPENING_BALANCE
  PURCHASE
  PAYMENT

  @@map("vendor_entry_type")
}

model Customer {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(120)
  nameKey     String    @map("name_key") @db.VarChar(120)
  phone       String?   @db.VarChar(30)
  phoneDigits String?   @map("phone_digits") @db.VarChar(20)
  email       String?   @db.VarChar(254)
  address     String?   @db.VarChar(300)
  balance     Decimal   @default(0) @db.Decimal(12, 2)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int       @default(1)
  legacyId    String?   @map("legacy_id") @db.VarChar(64)

  entries CustomerLedgerEntry[]
  orders  Order[]

  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_key_trgm_idx")
  @@map("customers")
}

model Vendor {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String    @db.VarChar(120)
  nameKey          String    @map("name_key") @db.VarChar(120)
  phone            String?   @db.VarChar(30)
  phoneDigits      String?   @map("phone_digits") @db.VarChar(20)
  email            String?   @db.VarChar(254)
  address          String?   @db.VarChar(300)
  productsSupplied String?   @map("products_supplied") @db.VarChar(300)
  balance          Decimal   @default(0) @db.Decimal(12, 2)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int       @default(1)
  legacyId         String?   @map("legacy_id") @db.VarChar(64)

  entries VendorLedgerEntry[]

  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "vendors_name_key_trgm_idx")
  @@map("vendors")
}

model CustomerLedgerEntry {
  id             BigInt            @id @default(autoincrement())
  customerId     String            @map("customer_id") @db.Uuid
  type           CustomerEntryType
  amount         Decimal           @db.Decimal(12, 2)
  balanceAfter   Decimal           @map("balance_after") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod?    @map("payment_method")
  note           String?           @db.VarChar(300)
  orderId        String?           @map("order_id") @db.Uuid
  refundId       String?           @map("refund_id") @db.Uuid
  idempotencyKey String?           @unique(map: "customer_ledger_idempotency_key_uq") @map("idempotency_key") @db.Uuid
  requestHash    Bytes?            @map("request_hash")
  businessDate   DateTime          @default(dbgenerated("((now() AT TIME ZONE 'Asia/Karachi'::text))::date")) @map("business_date") @db.Date
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyId       String?           @map("legacy_id") @db.VarChar(64)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, map: "customer_ledger_customer_fk")
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "customer_ledger_order_fk")
  refund   Refund?  @relation(fields: [refundId], references: [id], onDelete: Restrict, map: "customer_ledger_refund_fk")
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, map: "customer_ledger_actor_fk")

  @@index([customerId, createdAt(sort: Desc), id(sort: Desc)], map: "customer_ledger_customer_created_idx")
  @@map("customer_ledger_entries")
}

model VendorLedgerEntry {
  id             BigInt          @id @default(autoincrement())
  vendorId       String          @map("vendor_id") @db.Uuid
  type           VendorEntryType
  amount         Decimal         @db.Decimal(12, 2)
  balanceAfter   Decimal         @map("balance_after") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod?  @map("payment_method")
  note           String?         @db.VarChar(300)
  idempotencyKey String?         @unique(map: "vendor_ledger_idempotency_key_uq") @map("idempotency_key") @db.Uuid
  requestHash    Bytes?          @map("request_hash")
  businessDate   DateTime        @default(dbgenerated("((now() AT TIME ZONE 'Asia/Karachi'::text))::date")) @map("business_date") @db.Date
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyId       String?         @map("legacy_id") @db.VarChar(64)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict, map: "vendor_ledger_vendor_fk")
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: Restrict, map: "vendor_ledger_actor_fk")

  @@index([vendorId, createdAt(sort: Desc), id(sort: Desc)], map: "vendor_ledger_vendor_created_idx")
  @@map("vendor_ledger_entries")
}
