// Billing: daily bill counters, immutable orders with a financial snapshot, refunds (DATABASE.md §4.9–4.12).
// Arithmetic CHECKs, partial indexes and the bill-number pattern index live in the migration SQL.

enum DiscountType {
  NONE
  FLAT
  PERCENT

  @@map("discount_type")
}

enum OrderStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("order_status")
}

enum RefundSettlement {
  ORIGINAL_METHOD
  KHATA_CREDIT

  @@map("refund_settlement")
}

model BillNumberCounter {
  businessDate DateTime @id @map("business_date") @db.Date
  lastValue    Int      @map("last_value")

  @@map("bill_number_counters")
}

model Order {
  id                String        @id @default(uuid(7)) @db.Uuid
  billNumber        String        @unique(map: "orders_bill_number_uq") @map("bill_number") @db.VarChar(24)
  businessDate      DateTime      @map("business_date") @db.Date
  idempotencyKey    String        @unique(map: "orders_idempotency_key_uq") @map("idempotency_key") @db.Uuid
  requestHash       Bytes?        @map("request_hash")
  cashierId         String?       @map("cashier_id") @db.Uuid
  cashierName       String        @map("cashier_name") @db.VarChar(120)
  customerId        String?       @map("customer_id") @db.Uuid
  paymentMethod     PaymentMethod @map("payment_method")
  discountType      DiscountType  @map("discount_type")
  discountValue     Decimal       @map("discount_value") @db.Decimal(12, 2)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @map("discount_total") @db.Decimal(12, 2)
  itemDiscountTotal Decimal       @default(0) @map("item_discount_total") @db.Decimal(12, 2)
  productTaxTotal   Decimal       @map("product_tax_total") @db.Decimal(12, 2)
  billGstRate       Decimal?      @map("bill_gst_rate") @db.Decimal(5, 2)
  billGstAmount     Decimal       @default(0) @map("bill_gst_amount") @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  refundedTotal     Decimal       @default(0) @map("refunded_total") @db.Decimal(12, 2)
  status            OrderStatus   @default(COMPLETED)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  version           Int           @default(1)
  legacyId          String?       @map("legacy_id") @db.VarChar(64)

  cashier        User?                 @relation(fields: [cashierId], references: [id], onDelete: Restrict, map: "orders_cashier_fk")
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict, map: "orders_customer_fk")
  lines          OrderLine[]
  refunds        Refund[]
  ledgerEntries  CustomerLedgerEntry[]
  stockMovements StockMovement[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "orders_created_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "orders_status_created_idx")
  @@index([businessDate], map: "orders_business_date_idx")
  @@index([customerId, createdAt(sort: Desc), id(sort: Desc)], map: "orders_customer_created_idx")
  @@map("orders")
}

model OrderLine {
  id               BigInt   @id @default(autoincrement())
  orderId          String   @map("order_id") @db.Uuid
  lineNo           Int      @map("line_no") @db.SmallInt
  productId        String?  @map("product_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(200)
  productNameUrdu  String?  @map("product_name_urdu") @db.VarChar(200)
  barcode          String?  @db.VarChar(64)
  saleUnit         SaleUnit @map("sale_unit")
  piecesPerUnit    Int      @map("pieces_per_unit")
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRate          Decimal  @map("tax_rate") @db.Decimal(5, 2)
  lineGross        Decimal  @map("line_gross") @db.Decimal(12, 2)
  itemDiscount     Decimal  @default(0) @map("item_discount") @db.Decimal(12, 2)
  lineDiscount     Decimal  @map("line_discount") @db.Decimal(12, 2)
  lineNet          Decimal  @map("line_net") @db.Decimal(12, 2)
  lineTax          Decimal  @map("line_tax") @db.Decimal(12, 2)
  refundedQuantity Int      @default(0) @map("refunded_quantity")

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "order_lines_order_fk")
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict, map: "order_lines_product_fk")
  refundLines RefundLine[]

  @@unique([orderId, lineNo], map: "order_lines_order_line_no_uq")
  @@index([productId], map: "order_lines_product_idx")
  @@map("order_lines")
}

model Refund {
  id             String           @id @default(uuid(7)) @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  idempotencyKey String           @unique(map: "refunds_idempotency_key_uq") @map("idempotency_key") @db.Uuid
  requestHash    Bytes?           @map("request_hash")
  businessDate   DateTime         @default(dbgenerated("((now() AT TIME ZONE 'Asia/Karachi'::text))::date")) @map("business_date") @db.Date
  amount         Decimal          @db.Decimal(12, 2)
  billGstShare   Decimal          @map("bill_gst_share") @db.Decimal(12, 2)
  settlement     RefundSettlement
  paymentMethod  PaymentMethod    @map("payment_method")
  reason         String?          @db.VarChar(200)
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "refunds_order_fk")
  actor          User?                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict, map: "refunds_actor_fk")
  lines          RefundLine[]
  ledgerEntries  CustomerLedgerEntry[]
  stockMovements StockMovement[]

  @@index([orderId, createdAt], map: "refunds_order_idx")
  @@index([businessDate], map: "refunds_business_date_idx")
  @@map("refunds")
}

model RefundLine {
  id          BigInt  @id @default(autoincrement())
  refundId    String  @map("refund_id") @db.Uuid
  orderLineId BigInt  @map("order_line_id")
  quantity    Int
  amount      Decimal @db.Decimal(12, 2)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Restrict, map: "refund_lines_refund_fk")
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict, map: "refund_lines_order_line_fk")

  @@unique([refundId, orderLineId], map: "refund_lines_refund_line_uq")
  @@index([orderLineId], map: "refund_lines_order_line_idx")
  @@map("refund_lines")
}
