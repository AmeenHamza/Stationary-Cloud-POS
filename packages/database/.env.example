# Local development only. Copy to .env (git-ignored) and use the local service password.
# Production uses Neon: DATABASE_URL = pooled endpoint, DIRECT_DATABASE_URL = direct endpoint.
DATABASE_URL=postgresql://pos:change-me-local-only@localhost:5432/pos_dev
DIRECT_DATABASE_URL=postgresql://pos:change-me-local-only@localhost:5432/pos_dev
# Admin URL used by integration tests to create throwaway databases (role needs CREATEDB).
TEST_DATABASE_URL=postgresql://pos:change-me-local-only@localhost:5432/postgres

# --- Neon (cloud database) -------------------------------------------------------------------
# For migrations on Neon: paste both strings, uncomment them, comment out the local lines above,
# then run `pnpm --filter @pos/database migrate:deploy` (`pnpm db:migrate` refuses non-local hosts).
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
# DIRECT_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require
